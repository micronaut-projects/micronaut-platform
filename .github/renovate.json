{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>micronaut-projects/micronaut-project-template//.github/renovate-global"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Module BOMs: one pull request per module, as soon as it is released, outside the shared groups.",
      "matchPackageNames": [
        "/^io\\.micronaut(\\..+)?:micronaut-.+-bom$/"
      ],
      "groupName": "{{{packageName}}}",
      "groupSlug": "bom-{{{packageName}}}",
      "schedule": [
        "at any time"
      ],
      "prHourlyLimit": 0
    },
    {
      "description": "Patch and minor module BOM updates merge once every check passes. Renovate checks the status itself, so the merge never runs ahead of CI. Major updates stay manual.",
      "matchPackageNames": [
        "/^io\\.micronaut(\\..+)?:micronaut-.+-bom$/"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
