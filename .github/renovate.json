{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "addLabels": [
    "type: dependency-upgrade"
  ],
  "schedule": [
    "* 0-3 1 * *"
  ],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 20,
  "timezone": "Europe/Prague",
  "platformAutomerge": false,
  "packageRules": [
    {
      "dependencyDashboardApproval": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies"
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "matchManagers": [
        "maven",
        "gradle"
      ],
      "allowedVersions": "!/.+-SNAPSHOT$/"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "groupName": "GitHub Actions digest updates",
      "groupSlug": "github-actions-digest"
    },
    {
      "description": "Other Micronaut dependencies are grouped monthly, as in the shared configuration. Module BOMs are not.",
      "matchPackageNames": [
        "/.*micronaut.*/",
        "!/^io\\.micronaut(\\..+)?:micronaut-.+-bom$/"
      ],
      "groupName": "Micronaut dependencies"
    },
    {
      "description": "Module BOMs: one pull request per module, as soon as it is released.",
      "matchPackageNames": [
        "/^io\\.micronaut(\\..+)?:micronaut-.+-bom$/"
      ],
      "schedule": ["at any time"],
      "prHourlyLimit": 0
    },
    {
      "description": "Patch and minor module BOM updates merge once every check passes. Renovate checks the status itself, so the merge never runs ahead of CI. Major updates stay manual.",
      "matchPackageNames": [
        "/^io\\.micronaut(\\..+)?:micronaut-.+-bom$/"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
